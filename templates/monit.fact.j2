{
  "monit_configured_services": [
{% for service in monit_services %}
{% if (service.enabled is not defined) or (service.enabled is defined and service.enabled) %}
    "{{ service.name | replace(' ', '_') }}",
{% endif %}
{% endfor %}
{% if monit_mail_enabled %}
    "mail",
{% endif %}
    "webinterface"
  ]
}
